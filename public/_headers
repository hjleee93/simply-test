# Cache headers for Cloudflare Pages/Workers
# Note: Rules are additive; put specific paths first and avoid catch-all wildcards
# that would match already-specified paths.

# Hashed assets (JS, CSS) - immutable cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# OG images - cache for a week
/og/*
  Cache-Control: public, max-age=604800

# Character images - long cache (1 year)
/characters/*
  Cache-Control: public, max-age=31536000, immutable

# Brand assets - long cache (1 year)
/brand-logo.webp
  Cache-Control: public, max-age=31536000, immutable

/brand-logo.png
  Cache-Control: public, max-age=31536000, immutable

# Favicon and static images in root - cache for a day
/favicon*.png
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/og-image.png
  Cache-Control: public, max-age=86400

# HTML pages - no cache (always revalidate)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Sitemap and robots - short cache
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600
